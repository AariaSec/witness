# secrets / keys — never commit
*.pem
keys/
.witness/keys/
.env

# runs — only runs/frozen/ is tracked
runs/*
!runs/frozen/
!runs/frozen/**

# arena working output — frozen copies land in runs/frozen/arena-<date>/ instead
arena_runs/

# build artifacts
node_modules/
dist/
build/
*.egg-info/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.venv/

# video / large binaries never belong in this repo
*.mp4
*.mov

# OS
.DS_Store
