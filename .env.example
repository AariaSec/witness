# Copy to .env and fill in. Never commit the real .env (see .gitignore).
#
# These are only for the OPTIONAL live-analyst pass. Recording, detection,
# the merge gate and the console all work with no key at all; without a key
# the analyst falls back to a deterministic offline template.
#
# The CLI does not read .env by itself. Load it into your shell first:
#     set -a; source .env; set +a
# then run:  witness verify <bundle.jsonl> --with-analyst --analyst-provider meta

# Meta Model API key (first-party Muse Spark 1.3)  ->  --analyst-provider meta
META_API_KEY=

# Baseten key (Muse Spark Open, open-weight)       ->  --analyst-provider baseten
BASETEN_API_KEY=

# Optional second host of the same open-weight model -> --analyst-provider fireworks
FIREWORKS_API_KEY=
