# Copy to .env and fill in. Never commit the real .env (see .gitignore).

# Meta Model API key — used only by `witness analyze` (the read-only analyst
# pass over an already-recorded bundle). Recording and detection work with
# no key at all; this is optional and never required to view a bundle.
MUSE_API_KEY=

# Optional partner/open-weight endpoint (e.g. Baseten) used if MUSE_API_KEY
# is unset — see docs/ARCHITECTURE.md for the fallback path.
WITNESS_PARTNER_URL=
